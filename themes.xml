<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.AlfauzanData" parent="Theme.AppCompat.Light.NoActionBar">
        <item name="colorPrimary">@color/colorPrimary</item>
        <item name="colorPrimaryDark">@color/colorPrimaryDark</item>
        <item name="colorAccent">@color/colorAccent</item>
        <item name="android:windowBackground">@color/navyDark</item>
        <item name="android:statusBarColor">@color/navyDeep</item>
        <item name="android:navigationBarColor">@color/navyDeep</item>
        <item name="android:windowLightStatusBar">false</item>
    </style>

    <style name="Theme.AlfauzanData.Splash" parent="Theme.AppCompat.Light.NoActionBar">
        <item name="colorPrimary">@color/colorPrimary</item>
        <item name="colorPrimaryDark">@color/colorPrimaryDark</item>
        <item name="colorAccent">@color/colorAccent</item>
        <item name="android:windowBackground">@color/navyDeep</item>
        <item name="android:statusBarColor">@color/navyDeep</item>
        <item name="android:navigationBarColor">@color/navyDeep</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowFullscreen">true</item>
    </style>
</resources>
